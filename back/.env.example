# Copy this file to .env and fill in the values.
# The DATABASE_URL below matches the Postgres service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://testly:12345678@localhost:5434/testly_db

# JWT signing. Generate a SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256

# LLM / document parsing (needed for material upload & keyword extraction).
GROQ_API_KEY=your-groq-api-key
LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key
